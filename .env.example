# Required
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
SESSION_SECRET="a-long-random-string"   # e.g. openssl rand -hex 32
APP_URL="https://your-site.netlify.app"

# Optional: email (invites, reminders, receipts) through Resend
RESEND_API_KEY=""
EMAIL_FROM=""            # e.g. "Muhasabah <tuition@yourdomain.com>" (a domain verified in Resend)

# Optional: online card payments through Stripe
STRIPE_SECRET_KEY=""     # sk_live_... or sk_test_...
STRIPE_WEBHOOK_SECRET="" # whsec_... from the webhook pointing at /api/stripe-webhook
