DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Used to sign session cookies. Generate a new one with: openssl rand -base64 32
SESSION_SECRET=""

# Base URL used to build invite links. Update when deploying.
APP_URL="http://localhost:3000"

# Optional: set to send real invite emails via Resend (resend.com).
# If unset, invite links are just shown to the teacher to copy/share.
RESEND_API_KEY=""
