# Required
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
SESSION_SECRET="a-long-random-string"   # e.g. openssl rand -hex 32
APP_URL="https://your-site.netlify.app"

# Optional: email (invites, reminders, receipts) through Resend
RESEND_API_KEY=""
EMAIL_FROM=""            # e.g. "Muhasabah <tuition@yourdomain.com>" (a domain verified in Resend)


# Optional: "Continue with Google" (sign-in, registration and invite links)
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized redirect URIs: https://<your-site>/auth/google/callback and http://localhost:5173/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
