// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Student {
  id                 String          @id @default(cuid())
  name               String
  phone              String?
  email              String?
  tuitionAmount      Float
  firstPaymentAmount Float?
  priceNote          String?
  billingDay         Int
  nextDueDate        DateTime
  joinedAt           DateTime        @default(now())
  active             Boolean         @default(true)
  // Signed up through a link and waiting for the teacher to approve. Kept out of
  // billing, reminders and revenue until then.
  pendingApproval    Boolean         @default(false)
  notes              String?
  familyId           String?
  family             Family?         @relation(fields: [familyId], references: [id], onDelete: SetNull)
  payments           Payment[]
  reminders          Reminder[]
  progress           ProgressEntry[]
  enrollments        Enrollment[]
  invites            Invite[]
  user               User?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

// Singleton row (id always 1) holding class-wide billing config.
model Settings {
  id                 Int     @id @default(1)
  billingDay         Int     @default(1)
  autoEmailReminders Boolean @default(false)
}

// Siblings share a family: one contact, one portal view, one combined bill.
model Family {
  id           String    @id @default(cuid())
  name         String
  guardianName String?
  phone        String?
  email        String?
  students     Student[]
  createdAt    DateTime  @default(now())
}

// One row per reminder sent, so the daily job never sends the same one twice.
model Reminder {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  dueDate   DateTime
  kind      String // "upcoming" | "overdue"
  channel   String // "email"
  sentTo    String
  sentAt    DateTime @default(now())

  @@unique([studentId, dueDate, kind, channel])
}

enum ProgressKind {
  SABAQ // new lesson
  SABQI // recent revision
  MANZIL // older revision (dhor)
  NAZRA // reading
}

model ProgressEntry {
  id        String       @id @default(cuid())
  studentId String
  student   Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime
  kind      ProgressKind
  surah     Int
  fromAyah  Int?
  toAyah    Int?
  // 3 excellent, 2 good, 1 needs work
  quality   Int?
  mistakes  Int?
  note      String?
  createdAt DateTime     @default(now())

  @@index([studentId, date])
}

enum Role {
  TEACHER
  MEMBER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(MEMBER)
  studentId    String?  @unique
  student      Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
}

model Invite {
  id         String    @id @default(cuid())
  email      String
  token      String    @unique
  studentId  String
  student    Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  acceptedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
}

model Payment {
  id              String   @id @default(cuid())
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount          Float
  paidAt          DateTime @default(now())
  note            String?
  receiptNumber   Int      @unique @default(autoincrement())
  // "manual" when the teacher marks it paid, otherwise how the family says they
  // paid ("zelle", "venmo", "cash", ...) when it came from an uploaded proof.
  method          String   @default("manual")
  proofId         String?
  proof           PaymentProof? @relation(fields: [proofId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
}

// A family's "I paid" message: a screenshot of the Zelle (or other) transfer, the
// amount and which children it covers. The app never moves money; the teacher
// looks at the proof and confirms it, which records the payments.
model PaymentProof {
  id            String    @id @default(cuid())
  studentIds    String[]
  amount        Float
  paidOn        DateTime
  method        String
  note          String?
  // Downscaled JPEG/PNG/WebP, kept in the database (a few hundred KB each).
  image         Bytes?
  imageType     String?
  status        String    @default("pending") // pending | approved | rejected
  rejectReason  String?
  submittedById String?
  reviewedAt    DateTime?
  payments      Payment[]
  createdAt     DateTime  @default(now())

  @@index([status, createdAt])
}

model Program {
  id          String       @id @default(cuid())
  name        String
  days        String
  time        String
  location    String
  price       Float
  // How many days a week the full program meets, and which day counts parents
  // can sign up for. Price is prorated: price × chosen days ÷ daysPerWeek.
  daysPerWeek Int          @default(1)
  dayOptions  Int[]        @default([])
  active      Boolean      @default(true)
  enrollments Enrollment[]
  createdAt   DateTime     @default(now())
}

model Enrollment {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  programId   String
  program     Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  // Days a week this student attends, when fewer than the full program.
  daysPerWeek Int?
  createdAt   DateTime @default(now())

  @@unique([studentId, programId])
}

// A single-use sign-up link the teacher makes for one family. The parent picks each
// child's program and days a week; the price comes from the program.
// programIds and price are only set on older links that fixed them in advance.
model SignupLink {
  id         String    @id @default(cuid())
  token      String    @unique
  label      String?
  programIds String[]
  price      Float?
  expiresAt  DateTime
  usedAt     DateTime?
  familyId   String?
  createdAt  DateTime  @default(now())
}
